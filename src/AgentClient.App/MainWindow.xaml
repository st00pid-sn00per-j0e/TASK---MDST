<Window x:Class="AgentClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sandboxed CSV Agent" Height="800" Width="1100"
        Background="#F3F4F6" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Border" x:Key="MessageBubble">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MaxWidth" Value="700" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Visibility" Value="Visible" />
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="user">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="#0078D7" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                
                <DataTrigger Binding="{Binding Type}" Value="code_generated">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="TextElement.Foreground" Value="#D4D4D4" />
                    <Setter Property="TextElement.FontFamily" Value="Consolas" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Type}" Value="running">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="inspecting">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="executing">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="completed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="failed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="cancelled">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="DEBUG">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" Padding="16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="CSV Agent" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Foreground="#6B7280" Margin="0,4,0,0" />
                
                <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" Padding="10" Margin="0,10,0,0" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorClass}" FontWeight="Bold" Foreground="#B91C1C" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#7F1D1D" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <TextBlock Text="{Binding Message}" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" Margin="0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="running">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="inspecting">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="executing">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="completed">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="failed">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="cancelled">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="DEBUG">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Style="{StaticResource MessageBubble}">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFFFFF" Padding="16" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="📎 Attach CSV" Command="{Binding PickFileCommand}" 
                        Padding="10,8" Margin="0,0,10,0" Background="#F3F4F6" BorderBrush="#D1D5DB" />

                <TextBox Grid.Column="1" Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10" VerticalContentAlignment="Center" FontSize="14" 
                         BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB" />

                <Button Grid.Column="2" Content="⬇ Save Output" Command="{Binding DownloadOutputCommand}" 
                        Padding="10,8" Margin="10,0" Background="#F3F4F6" BorderBrush="#D1D5DB" />

                <Button Grid.Column="3" Content="Send" Command="{Binding StartRunCommand}" 
                        Padding="20,8" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>